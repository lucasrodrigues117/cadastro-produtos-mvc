<%- include('../partials/header') %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Categorias</h1>
    <p class="mt-1 text-slate-500">Organize os produtos por categoria.</p>
  </div>
  <a href="/categorias/novo" class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-amber-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-800 transition">
    <i class="ph-bold ph-plus"></i> Nova categoria
  </a>
</div>

<%- include('../partials/status') %>

<% if (categorias.length === 0) { %>
  <div class="rounded-2xl bg-white border border-slate-200 shadow-sm px-6 py-16 text-center">
    <i class="ph-light ph-tag text-5xl text-slate-300"></i>
    <p class="mt-3 text-slate-500 font-medium">Nenhuma categoria cadastrada.</p>
    <a href="/categorias/novo" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 hover:text-amber-800">
      Criar a primeira categoria <i class="ph-bold ph-arrow-right"></i>
    </a>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% categorias.forEach(c => { %>
      <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-6 flex flex-col">
        <div class="flex items-start justify-between">
          <div>
            <h2 class="font-bold text-lg text-slate-900"><%= c.nome %></h2>
            <p class="text-sm text-slate-400 mt-1">
              <%= c.produtos ? c.produtos.length : 0 %> produto(s)
            </p>
          </div>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 text-lg">
            <i class="ph-bold ph-tag"></i>
          </span>
        </div>

        <a href="/produtos/categoria/<%= c.id %>" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 hover:text-amber-800">
          Ver produtos desta categoria <i class="ph-bold ph-arrow-right"></i>
        </a>

        <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
          <a href="/categorias/<%= c.id %>/editar" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
            <i class="ph-bold ph-pencil-simple"></i> Editar
          </a>
          <form action="/categorias/<%= c.id %>/deletar" method="POST" onsubmit="return confirm('Excluir esta categoria? Os produtos ficarão sem categoria.');">
            <button type="submit" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition">
              <i class="ph-bold ph-trash"></i> Excluir
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
