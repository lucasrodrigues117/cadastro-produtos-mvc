<%- include('partials/header') %>

<div class="mb-10">
  <h1 class="text-3xl font-extrabold text-slate-900">Painel</h1>
  <p class="mt-2 text-slate-500">Visão geral do seu cadastro de produtos.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
  <div class="rounded-2xl bg-gradient-to-br from-amber-700 to-amber-900 text-white p-6 shadow-sm">
    <p class="text-amber-100 text-sm font-medium">Produtos cadastrados</p>
    <p class="mt-2 text-4xl font-extrabold"><%= totalProdutos %></p>
    <a href="/produtos" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-white/90 hover:text-white">
      Ver todos <i class="ph-bold ph-arrow-right"></i>
    </a>
  </div>
  <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
    <p class="text-slate-500 text-sm font-medium">Categorias</p>
    <p class="mt-2 text-4xl font-extrabold text-slate-900"><%= totalCategorias %></p>
    <a href="/categorias" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 hover:text-amber-800">
      Gerenciar <i class="ph-bold ph-arrow-right"></i>
    </a>
  </div>
</div>

<div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <h2 class="font-bold text-slate-900">Últimos produtos cadastrados</h2>
    <a href="/produtos/novo" class="inline-flex items-center gap-1 text-sm font-semibold text-amber-700 hover:text-amber-800">
      <i class="ph-bold ph-plus"></i> Novo produto
    </a>
  </div>

  <% if (ultimosProdutos.length === 0) { %>
    <div class="px-6 py-14 text-center">
      <i class="ph-light ph-package text-5xl text-slate-300"></i>
      <p class="mt-3 text-slate-400">Nenhum produto cadastrado ainda.</p>
    </div>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% ultimosProdutos.forEach(p => { %>
        <li class="px-6 py-4 flex items-center justify-between">
          <div>
            <p class="font-semibold text-slate-800"><%= p.nome %></p>
            <p class="text-sm text-slate-400"><%= p.categoria ? p.categoria.nome : 'Sem categoria' %></p>
          </div>
          <p class="font-semibold text-slate-700 tabular-nums">
            <%= Number(p.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
          </p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('partials/footer') %>
