<%- include('../partials/header') %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Produtos</h1>
    <p class="mt-1 text-slate-500">Gerencie o estoque da loja.</p>
  </div>
  <a href="/produtos/novo" class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-amber-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-800 transition">
    <i class="ph-bold ph-plus"></i> Novo produto
  </a>
</div>

<%- include('../partials/status') %>

<form method="GET" action="/produtos" class="mb-6 flex flex-col sm:flex-row gap-3">
  <div class="relative flex-1">
    <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
    <input
      type="text"
      name="q"
      value="<%= filtroBusca %>"
      placeholder="Pesquisar por nome..."
      class="w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
    >
  </div>
  <select name="categoria" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
    <option value="">Todas as categorias</option>
    <% categorias.forEach(c => { %>
      <option value="<%= c.id %>" <%= String(c.id) === String(filtroCategoria) ? 'selected' : '' %>>
        <%= c.nome %>
      </option>
    <% }) %>
  </select>
  <button type="submit" class="btn-press rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition">
    Filtrar
  </button>
  <% if (filtroBusca || filtroCategoria) { %>
    <a href="/produtos" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-100 transition">
      Limpar
    </a>
  <% } %>
</form>

<div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
  <% if (produtos.length === 0) { %>
    <div class="px-6 py-16 text-center">
      <i class="ph-light ph-package text-5xl text-slate-300"></i>
      <p class="mt-3 text-slate-500 font-medium">Nenhum produto encontrado.</p>
      <a href="/produtos/novo" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 hover:text-amber-800">
        Cadastrar o primeiro produto <i class="ph-bold ph-arrow-right"></i>
      </a>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <th class="px-6 py-3">Nome</th>
            <th class="px-6 py-3">Categoria</th>
            <th class="px-6 py-3">Preço</th>
            <th class="px-6 py-3">Quantidade</th>
            <th class="px-6 py-3 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% produtos.forEach(p => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= p.nome %></td>
              <td class="px-6 py-4">
                <% if (p.categoria) { %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">
                    <i class="ph-bold ph-tag"></i> <%= p.categoria.nome %>
                  </span>
                <% } else { %>
                  <span class="text-slate-400 text-xs">Sem categoria</span>
                <% } %>
              </td>
              <td class="px-6 py-4 text-slate-600 tabular-nums">
                <%= Number(p.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center rounded-full <%= p.quantidade > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %> px-2.5 py-1 text-xs font-semibold tabular-nums">
                  <%= p.quantidade %> un.
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-1">
                  <a href="/produtos/<%= p.id %>/editar" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                    <i class="ph-bold ph-pencil-simple"></i> Editar
                  </a>
                  <form action="/produtos/<%= p.id %>/deletar" method="POST" onsubmit="return confirm('Excluir este produto?');">
                    <button type="submit" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition">
                      <i class="ph-bold ph-trash"></i> Excluir
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
