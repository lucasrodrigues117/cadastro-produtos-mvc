<%- include('../partials/header') %>

<div class="max-w-xl mx-auto">
  <a href="/produtos" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-slate-700">
    <i class="ph-bold ph-arrow-left"></i> Voltar para produtos
  </a>

  <h1 class="mt-4 text-3xl font-extrabold text-slate-900">Editar produto</h1>
  <p class="mt-1 text-slate-500 mb-8">Atualize os dados de <strong><%= produto.nome %></strong>.</p>

  <form action="/produtos/<%= produto.id %>" method="POST" class="rounded-2xl bg-white border border-slate-200 shadow-sm p-6 space-y-5">
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nome</label>
      <input
        type="text" name="nome" required value="<%= produto.nome %>"
        class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Preço (R$)</label>
        <input
          type="number" name="preco" step="0.01" min="0" required value="<%= produto.preco %>"
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Quantidade</label>
        <input
          type="number" name="quantidade" min="0" value="<%= produto.quantidade %>"
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
      </div>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1.5">Categoria</label>
      <select name="categoriaId" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
        <option value="">Sem categoria</option>
        <% categorias.forEach(c => { %>
          <option value="<%= c.id %>" <%= produto.categoriaId === c.id ? 'selected' : '' %>>
            <%= c.nome %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="btn-press rounded-xl bg-amber-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-800 transition">
        Atualizar produto
      </button>
      <a href="/produtos" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-100 transition">
        Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
